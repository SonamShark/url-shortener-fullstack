# Values consumed by docker-compose.yml on the VM.
# Copy to `.env` in this same folder and edit before `docker compose up -d`.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-something-strong
POSTGRES_DB=shorty

# Public URL your VM is reachable at. Used to build shortUrl in responses.
# For raw IP: http://203.0.113.45
# For nip.io + HTTPS later: https://203.0.113.45.nip.io
PUBLIC_BASE_URL=http://YOUR_VM_IP

# CORS origin(s) allowed to hit the backend. Comma-separated or "*" for any.
CORS_ORIGIN=*
